<Project>
  <!--
    Fallback Sts2Dir when local.props is absent (CI format-check, fresh clones).
    Version must stay in sync with scripts/lib/sts2_profiles.py (PINNED_VERSION).
  -->
  <PropertyGroup>
    <KitLibSts2RefsStableVersion>0.107.1</KitLibSts2RefsStableVersion>
    <KitLibSts2RefsBetaVersion>0.109.0</KitLibSts2RefsBetaVersion>
    <KitLibSts2PinnedVersion Condition="'$(Sts2Profile)' == 'stable'">$(KitLibSts2RefsStableVersion)</KitLibSts2PinnedVersion>
    <KitLibSts2PinnedVersion Condition="'$(Sts2Profile)' != 'stable'">$(KitLibSts2RefsBetaVersion)</KitLibSts2PinnedVersion>
    <KitLibSts2RefsRoot>$(RepoRoot)eng/sts2-refs/$(Sts2Profile)/$(KitLibSts2PinnedVersion)</KitLibSts2RefsRoot>
    <KitLibSts2RefsDataDir>$(KitLibSts2RefsRoot)/data_sts2_windows_x86_64</KitLibSts2RefsDataDir>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Sts2Dir)' == '' and Exists('$(KitLibSts2RefsDataDir)/sts2.dll')">
    <Sts2Dir>$(KitLibSts2RefsRoot)</Sts2Dir>
    <Sts2DataDir>$(KitLibSts2RefsDataDir)</Sts2DataDir>
  </PropertyGroup>
</Project>
