<Project>
  <!--
    KitLib variant bundle baseline.
    Enable with -p:KitLibPersonalCompat=true or make bundle / sync-bundle.

    Targets: stable 0.111.1 + beta 0.113.1 (see scripts/package_bundle.py).
  -->
  <PropertyGroup>
    <KitLibPersonalCompatTargets>0.111.1;0.113.1</KitLibPersonalCompatTargets>
    <KitLibPersonalStableVersion>0.111.1</KitLibPersonalStableVersion>
    <KitLibPersonalBetaVersion>0.113.1</KitLibPersonalBetaVersion>
  </PropertyGroup>
</Project>
