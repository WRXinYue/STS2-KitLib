<Project>
  <!--
    Personal multi-version KitLib builds (local only; not used by CI/release).
    Enable with -p:KitLibPersonalCompat=true or make bundle-personal / sync-personal.

    Targets: stable 0.107.1 + beta 0.109.0 (see scripts/package_personal_bundle.py).
  -->
  <PropertyGroup>
    <KitLibPersonalCompatTargets>0.107.1;0.109.0</KitLibPersonalCompatTargets>
    <KitLibPersonalStableVersion>0.107.1</KitLibPersonalStableVersion>
    <KitLibPersonalBetaVersion>0.109.0</KitLibPersonalBetaVersion>
  </PropertyGroup>
</Project>
