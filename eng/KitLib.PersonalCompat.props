<Project>
  <!--
    Multi-version KitLib builds (stable + beta).
    Enable with -p:KitLibPersonalCompat=true or make bundle / sync-bundle.

    Targets: stable 0.107.1 + beta 0.109.0 (see scripts/package_bundle.py).
  -->
  <PropertyGroup>
    <KitLibPersonalCompatTargets>0.107.1;0.109.0</KitLibPersonalCompatTargets>
    <KitLibPersonalStableVersion>0.107.1</KitLibPersonalStableVersion>
    <KitLibPersonalBetaVersion>0.109.0</KitLibPersonalBetaVersion>
  </PropertyGroup>
</Project>
