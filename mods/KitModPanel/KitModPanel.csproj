<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="$(RepoRoot)eng\KitLib.Mod.Shared.props" />
  <PropertyGroup>
    <ModId>KitModPanel</ModId>
    <AssemblyName>KitModPanel</AssemblyName>
    <RootNamespace>KitLib</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <KitLibSourceDir>src</KitLibSourceDir>
    <RepoBuildDir>$(RepoRoot)build\$(ModId)</RepoBuildDir>
    <PublishDir>$(RepoBuildDir)</PublishDir>
    <OutputPath>$(RepoBuildDir)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <Import Project="$(RepoRoot)eng\KitLib.ProductSatellite.Compile.props" />
  <ItemGroup>
    <Compile Include="MainFile.cs" />
    <None Include="KitModPanel.json" Condition="Exists('KitModPanel.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>mod_manifest.json</TargetPath>
    </None>
  </ItemGroup>
  <Target Name="ForceModOutputPath" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <RepoBuildDir>$(RepoRoot)build\$(ModId)</RepoBuildDir>
      <PublishDir>$(RepoBuildDir)</PublishDir>
      <OutputPath>$(RepoBuildDir)\</OutputPath>
      <OutDir>$(RepoBuildDir)\</OutDir>
      <IntermediateOutputPath>$(RepoBuildDir)\obj\</IntermediateOutputPath>
    </PropertyGroup>
    <MakeDir Directories="$(RepoBuildDir);$(RepoBuildDir)\obj" />
  </Target>
  <Target Name="StripGodotSdkArtifacts" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Analyzer Remove="@(Analyzer)" Condition="$([System.String]::Copy('%(Identity)').Contains('Godot'))" />
      <Compile Remove="@(Compile)" Condition="$([System.String]::Copy('%(Identity)').Contains('Godot.SourceGenerators'))" />
      <Compile Remove="@(Compile)" Condition="$([System.String]::Copy('%(Identity)').Contains('GodotPlugins'))" />
    </ItemGroup>
  </Target>
  <Target Name="ShakeAndEmbedIcons" BeforeTargets="AssignTargetPaths">
    <Exec Command="&quot;$(KitLibPython)&quot; &quot;$(RepoRoot)scripts\shake_icons.py&quot;"
          WorkingDirectory="$(RepoRoot)"
          Condition="Exists('$(RepoRoot)scripts\shake_icons.py')"
          StandardOutputImportance="low" />
    <Warning Condition="!Exists('$(KitLibSourceDir)\Icons\mdi-used.json')"
             Text="Icons\mdi-used.json missing: $(ModId) will embed NO icons and every lookup warns at runtime. Run: $(KitLibPython) scripts/shake_icons.py" />
    <ItemGroup>
      <_ShakenIconSource Include="$(MSBuildProjectDirectory)\$(KitLibSourceDir)\Icons\MdiIcon.Generated.cs"
                         Condition="Exists('$(MSBuildProjectDirectory)\$(KitLibSourceDir)\Icons\MdiIcon.Generated.cs')" />
      <Compile Include="@(_ShakenIconSource)" Exclude="@(Compile)" />
      <EmbeddedResource Include="$(KitLibSourceDir)\Icons\mdi-used.json" LogicalName="KitLib.ModPanel.Icons.mdi-used.json"
                        Condition="Exists('$(KitLibSourceDir)\Icons\mdi-used.json')" />
    </ItemGroup>
  </Target>
</Project>
