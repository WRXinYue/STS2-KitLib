<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="$(RepoRoot)eng\KitLib.Mod.Shared.props" />
  <PropertyGroup>
    <ModId>KitLib.Dev</ModId>
    <KitLibProductId>KitDevTools</KitLibProductId>
    <AssemblyName>KitLib.Dev</AssemblyName>
    <RootNamespace>KitLib</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <KitLibSourceDir>src\Dev</KitLibSourceDir>
  </PropertyGroup>
  <Import Project="$(RepoRoot)eng\KitLib.SatelliteMod.targets" />
  <Import Project="$(RepoRoot)eng\KitLib.ProductSatellite.Compile.props" />
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>KitLib.Panel</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="KitLib.Cheat.csproj" />
    <ProjectReference Include="..\KitAI\KitLib.AI.csproj" />
    <ProjectReference Include="..\KitLib\KitLib.User.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(KitLibSourceDir)\Data\harmony-patch-registry.json" LogicalName="KitLib.Data.harmony-patch-registry.json" />
    <EmbeddedResource Include="$(KitLibSourceDir)\CombatStats\viewer-shell.html" LogicalName="KitLib.CombatStats.viewer-shell.html"
                      Condition="Exists('$(KitLibSourceDir)\CombatStats\viewer-shell.html')" />
  </ItemGroup>
</Project>
