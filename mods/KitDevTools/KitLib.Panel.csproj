<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="$(RepoRoot)eng\KitLib.Mod.Shared.props" />
  <PropertyGroup>
    <ModId>KitLib.Panel</ModId>
    <KitLibProductId>KitDevTools</KitLibProductId>
    <AssemblyName>KitLib.Panel</AssemblyName>
    <RootNamespace>KitLib</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <KitLibSourceDir>src\Panel</KitLibSourceDir>
    <GodotExportPreset>BasicExport</GodotExportPreset>
    <RunPckExport>false</RunPckExport>
  </PropertyGroup>
  <Import Project="$(RepoRoot)eng\KitLib.SatelliteMod.targets" />
  <PropertyGroup>
    <ModPckPath>$(PublishDir)\$(ModId).pck</ModPckPath>
  </PropertyGroup>
  <Import Project="$(RepoRoot)eng\KitLib.ProductSatellite.Compile.props" />
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>KitLib.Dev</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>KitLib.AI</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="KitLib.Dev.csproj" />
    <ProjectReference Include="..\KitAI\KitLib.AI.csproj" />
  </ItemGroup>
  <Target Name="ShakeAndEmbedIcons" BeforeTargets="AssignTargetPaths">
    <Exec Command="&quot;$(KitLibPython)&quot; &quot;$(RepoRoot)scripts\shake_icons.py&quot;"
          WorkingDirectory="$(RepoRoot)"
          Condition="Exists('$(RepoRoot)scripts\shake_icons.py')"
          StandardOutputImportance="low" />
    <Warning Condition="!Exists('$(KitLibSourceDir)\Icons\mdi-used.json')"
             Text="Icons\mdi-used.json missing: $(ModId) will embed NO icons and every lookup warns at runtime. Run: $(KitLibPython) scripts/shake_icons.py" />
    <ItemGroup>
      <_ShakenIconSource Include="$(MSBuildProjectDirectory)\$(KitLibSourceDir)\Icons\MdiIcon.Generated.cs"
                         Condition="Exists('$(MSBuildProjectDirectory)\$(KitLibSourceDir)\Icons\MdiIcon.Generated.cs')" />
      <Compile Include="@(_ShakenIconSource)" Exclude="@(Compile)" />
      <EmbeddedResource Include="$(KitLibSourceDir)\Icons\mdi-used.json" LogicalName="KitLib.Icons.mdi-used.json"
                        Condition="Exists('$(KitLibSourceDir)\Icons\mdi-used.json')" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <Content Include="$(KitLibSourceDir)\Assets\**" LinkBase="KitLib" />
  </ItemGroup>
  <Target Name="ExportPanelPck" AfterTargets="Build" Condition="'$(RunPckExport)' == 'true' and Exists('$(GodotExe)')">
    <Exec Command="&quot;$(GodotExe)&quot; --headless --path &quot;$(RepoRoot)&quot; --export-pack &quot;$(GodotExportPreset)&quot; &quot;$(ModPckPath)&quot;"
          EnvironmentVariables="STS2_SKIP_PCK_EXPORT=1" />
  </Target>
</Project>
