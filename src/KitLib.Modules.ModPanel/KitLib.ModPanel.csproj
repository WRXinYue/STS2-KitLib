<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="$(RepoRoot)eng\KitLib.Mod.Shared.props" />
  <PropertyGroup>
    <ModId>KitLib.ModPanel</ModId>
    <AssemblyName>KitLib.ModPanel</AssemblyName>
    <RootNamespace>KitLib</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <Import Project="$(RepoRoot)eng\KitLib.SatelliteMod.targets" />
  <Import Project="$(RepoRoot)eng\KitLib.Satellite.Compile.props" />
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>KitLib.Panel</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\KitLib.Modules.User\KitLib.User.csproj" />
  </ItemGroup>
  <!-- Added from a target, not statically — see the same target in KitLib.Panel.csproj. -->
  <Target Name="ShakeAndEmbedIcons" BeforeTargets="AssignTargetPaths">
    <Exec Command="&quot;$(KitLibPython)&quot; &quot;$(RepoRoot)scripts\shake_icons.py&quot;"
          WorkingDirectory="$(RepoRoot)"
          Condition="Exists('$(RepoRoot)scripts\shake_icons.py')"
          StandardOutputImportance="low" />
    <Warning Condition="!Exists('Icons\mdi-used.json')"
             Text="Icons\mdi-used.json missing: $(ModId) will embed NO icons and every lookup warns at runtime. Run: $(KitLibPython) scripts/shake_icons.py" />
    <ItemGroup>
      <_ShakenIconSource Include="$(MSBuildProjectDirectory)\Icons\MdiIcon.Generated.cs"
                         Condition="Exists('$(MSBuildProjectDirectory)\Icons\MdiIcon.Generated.cs')" />
      <Compile Include="@(_ShakenIconSource)" Exclude="@(Compile)" />
      <EmbeddedResource Include="Icons\mdi-used.json" LogicalName="KitLib.ModPanel.Icons.mdi-used.json"
                        Condition="Exists('Icons\mdi-used.json')" />
    </ItemGroup>
  </Target>
</Project>
