<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="$(RepoRoot)eng\KitLib.Mod.Shared.props" />
  <PropertyGroup>
    <ModId>KitLib.Panel</ModId>
    <AssemblyName>KitLib.Panel</AssemblyName>
    <RootNamespace>KitLib</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GodotExportPreset>BasicExport</GodotExportPreset>
    <RunPckExport>false</RunPckExport>
  </PropertyGroup>
  <Import Project="$(RepoRoot)eng\KitLib.SatelliteMod.targets" />
  <PropertyGroup>
    <ModPckPath>$(PublishDir)\$(ModId).pck</ModPckPath>
  </PropertyGroup>
  <Import Project="$(RepoRoot)eng\KitLib.Satellite.Compile.props" />
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>KitLib.Dev</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\KitLib.Modules.ModPanel\KitLib.ModPanel.csproj" />
    <ProjectReference Include="..\KitLib.Modules.Cheat\KitLib.Cheat.csproj" />
    <ProjectReference Include="..\KitLib.Modules.AI\KitLib.AI.csproj" />
    <ProjectReference Include="..\KitLib.Modules.Dev\KitLib.Dev.csproj" />
    <ProjectReference Include="..\KitLib.Modules.User\KitLib.User.csproj" />
  </ItemGroup>
  <!--
    Added from a target rather than statically: Icons\mdi-used.json and Icons\MdiIcon.Generated.cs
    are GENERATED, and a static item's Exists() condition is evaluated when THIS project is
    LOADED — before anything has generated them on a clean tree. A static item therefore
    silently embedded nothing, which is exactly how this module shipped with no icon set at
    all while every runtime lookup logged "icon not found". The Warning below covers the
    remaining hole: the generator can be skipped (no scripts\shake_icons.py, no python), and
    that must be loud rather than another silently icon-less build.
  -->
  <!--
    This project GENERATES its own icon assets rather than waiting for another project to
    do it, and hooks AssignTargetPaths, which is the only anchor where both item kinds still
    land. Two earlier attempts failed for opposite reasons, so do not "simplify" this — in
    particular, do not move the generation back into KitLib.Core: there is deliberately no
    ShakeIcons target there, and the comment in KitLib.Core.csproj says why.

      - Generating in KitLib.Core and hooking PrepareForBuild: PrepareForBuild is ordered
        BEFORE ResolveReferences, and ResolveReferences is what builds the referenced Core.
        The MSBuild trace showed "1>PrepareForBuild" ahead of "4>ShakeIcons" — nothing was
        generated yet, so nothing was picked up.
      - Hooking PrepareResources instead: late enough for Compile (consumed at CoreCompile)
        but too late for EmbeddedResource, because AssignTargetPaths has already stamped the
        resource list. The build then succeeded with the icons silently NOT embedded, which
        is the exact failure being fixed here.

    Generating per-consumer means two projects can run the shaker at once on a parallel
    build; shake_icons.py writes atomically so that is safe.
  -->
  <Target Name="ShakeAndEmbedIcons" BeforeTargets="AssignTargetPaths">
    <Exec Command="&quot;$(KitLibPython)&quot; &quot;$(RepoRoot)scripts\shake_icons.py&quot;"
          WorkingDirectory="$(RepoRoot)"
          Condition="Exists('$(RepoRoot)scripts\shake_icons.py')"
          StandardOutputImportance="low" />
    <Warning Condition="!Exists('Icons\mdi-used.json')"
             Text="Icons\mdi-used.json missing: $(ModId) will embed NO icons and every lookup warns at runtime. Run: $(KitLibPython) scripts/shake_icons.py" />
    <ItemGroup>
      <!--
        MdiIcon.Generated.cs is generated by the same run and must be picked up the same
        way: eng/KitLib.Satellite.Compile.props globs **\*.cs at LOAD time, so on a clean
        tree the glob misses it and the build fails on the first pass but succeeds on the
        second. Absolute path so Exclude matches the glob's own item identities and the
        file cannot be compiled twice.
      -->
      <_ShakenIconSource Include="$(MSBuildProjectDirectory)\Icons\MdiIcon.Generated.cs"
                         Condition="Exists('$(MSBuildProjectDirectory)\Icons\MdiIcon.Generated.cs')" />
      <Compile Include="@(_ShakenIconSource)" Exclude="@(Compile)" />
      <EmbeddedResource Include="Icons\mdi-used.json" LogicalName="KitLib.Icons.mdi-used.json"
                        Condition="Exists('Icons\mdi-used.json')" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <Content Include="Assets\**" LinkBase="KitLib" />
  </ItemGroup>
  <Target Name="ExportPanelPck" AfterTargets="Build" Condition="'$(RunPckExport)' == 'true' and Exists('$(GodotExe)')">
    <Exec Command="&quot;$(GodotExe)&quot; --headless --path &quot;$(RepoRoot)&quot; --export-pack &quot;$(GodotExportPreset)&quot; &quot;$(ModPckPath)&quot;"
          EnvironmentVariables="STS2_SKIP_PCK_EXPORT=1" />
  </Target>
</Project>
