# Copy this file to .env and fill in secrets.
# .env is git-ignored; never commit real keys.
# Shared release IDs (Nexus file groups, STS2_WORKSHOP_ID) live in release.env.

# -------------------------------------------------------------------
# Nexus Mods upload (scripts/publish_nexus.py / make upload-nexus)
# -------------------------------------------------------------------

# Personal API key — https://www.nexusmods.com/settings/api-keys
NEXUS_API_KEY=

# -------------------------------------------------------------------
# Steam Workshop upload (scripts/publish_steam.py / make upload-steam)
# -------------------------------------------------------------------

# Path to the official ModUploader for this OS
# (Windows: ModUploader.exe; macOS/Linux: ModUploader).
# One-time setup downloads the right build and fills this in:
#   make setup-steam-uploader
# Manual download: https://github.com/megacrit/sts2-mod-uploader/releases
# STS2_MOD_UPLOADER=C:\tools\sts2-mod-uploader\ModUploader.exe
# STS2_MOD_UPLOADER=/Users/you/.local/share/kitlib/sts2-mod-uploader/osx-arm64/ModUploader

# Workshop item ID override (default in release.env: STS2_WORKSHOP_ID)
# STS2_WORKSHOP_ID=
