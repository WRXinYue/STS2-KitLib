# Committed release IDs and Workshop metadata defaults.
# Secrets stay in .env (git-ignored). .env overrides values here when both define a key.

# Nexus Mods file group IDs (mod page → Files → API Info)
NEXUS_FILE_GROUP_ID=7276118
NEXUS_FILE_GROUP_ID_BETA=7633154
NEXUS_FILE_GROUP_ID_MCP=7491569

# Steam Workshop item ID (default upload omits minBranch/maxBranch; use make upload-steam BRANCH_TARGETING=1 to pin public-beta)
STS2_WORKSHOP_ID=3747619669
# STS2_WORKSHOP_ID_KITMODPANEL=
# STS2_WORKSHOP_ID_KITDEVTOOLS=

STS2_WORKSHOP_ID_KITDEVTOOLS=3793490840

STS2_WORKSHOP_ID_KITMODPANEL=3793495384
